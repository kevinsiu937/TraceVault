#!/bin/sh
# TraceVault pre-commit gate — a failing test must never reach a commit.
# Bypassing with --no-verify is a rules violation, not a shortcut.

set -e

echo "[pre-commit] typecheck"
npm run --silent typecheck

echo "[pre-commit] tests"
TEST_OUTPUT=$(npm run --silent test -- --passWithNoTests 2>&1) || {
  echo "$TEST_OUTPUT"
  echo "[pre-commit] BLOCKED: tests failed."
  exit 1
}
echo "$TEST_OUTPUT"

if echo "$TEST_OUTPUT" | grep -qi "no test files found"; then
  echo "[pre-commit] WARNING: no test files yet. Phase 1 needs two seam suites, not a test per class."
fi

echo "[pre-commit] ok"
